# Local development only. Copy to .env; never use these credentials in production.
POSTGRES_DB=expo_report
POSTGRES_USER=expo
POSTGRES_PASSWORD=expo_report_local
POSTGRES_PORT=35432
SERVER_PORT=8083
SWAGGER_ENABLED=false
SWAGGER_INCLUDE_INTERNAL=false
LOCAL_SECURITY_USER=developer
LOCAL_SECURITY_PASSWORD=expo_report_local
# Auth 서버(Expo-User-Server) 액세스 토큰 서명 검증용 RS256 공개키(SPKI PEM). 공개키라 비밀은 아니다.
# PEM 줄바꿈은 \n 으로 적어 한 줄로 넣는다. 예: -----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----
# 비어 있으면 서버가 기동에 실패한다. 테스트는 src/test의 TestJwt 키를 주입하므로 이 값이 필요 없다.
JWT_PUBLIC_KEY=
# 엑셀 원천 공급자 내부 API(X-Internal-Token). 주소·토큰이 비어 있으면 서버가 기동에 실패한다.
# 주소는 각 서비스를 로컬에서 띄운 포트에 맞춘다(서비스마다 기본 포트가 8080이라 겹치지 않게 바꿔 띄운다).
# 토큰은 공급자 쪽 값과 같아야 한다: User INTERNAL_TOKEN, Application APPLICATION_INTERNAL_TOKEN, Expo EXPO_INTERNAL_TOKEN.
# 실제 값은 커밋하지 않는다. 로컬 생성 예: openssl rand -base64 32
USER_SERVICE_URL=http://localhost:8081
USER_INTERNAL_TOKEN=
APPLICATION_SERVICE_URL=http://localhost:8082
APPLICATION_INTERNAL_TOKEN=
EXPO_SERVICE_URL=http://localhost:8084
EXPO_INTERNAL_TOKEN=
# 선택: 입장 기록 엑셀(Expo-Attendance-Server). 둘 다 비우면 그 다운로드만 503이고 서버는 기동한다. 하나만 넣으면 기동에 실패한다.
# 토큰은 Attendance INTERNAL_TOKEN과 같아야 하며 32자 이상이다.
ATTENDANCE_SERVICE_URL=
ATTENDANCE_INTERNAL_TOKEN=
# 선택: 공개 설문 응답 엑셀(Expo-Form-Server). 규칙은 위와 같고 토큰은 Form INTERNAL_TOKEN과 같아야 한다.
FORM_SERVICE_URL=
FORM_INTERNAL_TOKEN=
# 선택: 공급자 연결/응답 타임아웃(Duration). 비우면 3s/10s.
# CLIENT_CONNECT_TIMEOUT=3s
# CLIENT_READ_TIMEOUT=10s
